# Backend environment variables
# Copy this file to .env and fill in your local values.
# Do NOT commit .env with real credentials.

NODE_ENV=development
PORT=5000

# PostgreSQL
DATABASE_URL=postgresql://drch_user:change_me_locally@localhost:5432/drch_dev

# JWT Secrets (generate strong random strings for production)
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret

# Cookie domain (leave empty for localhost)
COOKIE_DOMAIN=

# Frontend origin (for CORS)
FRONTEND_URL=http://localhost:5173

# Web Push VAPID Keys (generate once via: npx web-push generate-vapid-keys)
# In production, valid 65-byte public key and 32-byte private key are required.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@drch.gov

# S3 / MinIO Object Storage
# In local development, if unset these automatically default to root .env MinIO credentials
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=change_me_locally
# S3_BUCKET_NAME=drch-media

