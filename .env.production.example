# ============================================================
# DRCH Production Environment Configuration Template
# Copy this file to .env.production and provide real secrets.
# NEVER commit .env.production or any real secret to Git.
# ============================================================

# Environment & Server
NODE_ENV=production
PORT=5000

# PostgreSQL Database Configuration
POSTGRES_USER=drch_prod_user
POSTGRES_PASSWORD=replace_with_strong_production_password_min_32_chars
POSTGRES_DB=drch_prod

# JWT Authentication Secrets (Must be distinct and at least 64 random characters)
JWT_ACCESS_SECRET=replace_with_random_64_char_secret_for_access_tokens_do_not_share
JWT_REFRESH_SECRET=replace_with_random_64_char_secret_for_refresh_tokens_do_not_share

# Cookie & Domain Configuration
# COOKIE_DOMAIN: Leave blank for single-domain deployment, or specify domain if sharing across subdomains
COOKIE_DOMAIN=
# FRONTEND_URL: Public HTTPS origin where users access the platform
FRONTEND_URL=https://drch.example.com
TRUST_PROXY_HOPS=1

# S3 / MinIO Object Storage
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=replace_with_minio_production_access_key
S3_SECRET_KEY=replace_with_minio_production_secret_key
S3_BUCKET_NAME=drch-media
MINIO_ROOT_USER=replace_with_minio_production_access_key
MINIO_ROOT_PASSWORD=replace_with_minio_production_secret_key

# Web Push VAPID Configuration
# Generate once via: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=replace_with_generated_65_byte_base64url_public_key
VAPID_PRIVATE_KEY=replace_with_generated_32_byte_base64url_private_key
VAPID_SUBJECT=mailto:admin@drch.example.com

# AI Evaluation Service (Multimodal Gemini)
GEMINI_API_KEY=replace_with_valid_google_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Frontend Build Configuration
# In single-domain production behind Nginx, relative URLs ("") are used
VITE_API_URL=

# TLS / SSL Certificate Paths (Decision 5.2 — Externally Provisioned SSL)
# Paths to your externally provisioned SSL certificate and private key on the host
SSL_CERT_PATH=/etc/ssl/certs/drch.crt
SSL_KEY_PATH=/etc/ssl/private/drch.key
